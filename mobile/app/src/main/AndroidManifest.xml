<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Wearable collector reads the Samsung Health export under
         Download/Samsung Health/ (shared external storage, ADR-021 D3).
         Mirrors the boox module's MANAGE_EXTERNAL_STORAGE declaration.
         Runtime grant: Settings > Apps > Special access > All files access,
         or `adb shell appops set com.pmbrs.mobile MANAGE_EXTERNAL_STORAGE allow`. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:label="PMBRS Mobile"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowserTelemetryActivity"
            android:exported="false" />
        <receiver
            android:name=".collectors.BrowserIntentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.pmbrs.mobile.ACTION_BROWSER_VISIT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>